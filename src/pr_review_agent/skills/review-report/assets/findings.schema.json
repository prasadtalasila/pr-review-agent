{
  "type": "object",
  "properties": {
    "assessment": {
      "type": "object",
      "properties": {
        "effort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "safe_to_merge",
            "merge_with_caution",
            "changes_required"
          ]
        },
        "priority_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5
        }
      },
      "required": [
        "effort",
        "risk",
        "recommendation",
        "priority_files"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "line",
          "severity",
          "title",
          "body"
        ]
      }
    }
  },
  "required": [
    "assessment",
    "findings"
  ]
}
